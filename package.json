{
  "name": "keyward",
  "version": "0.1.0",
  "private": true,
  "description": "Fast Bitwarden/Vaultwarden-compatible browser extension with a Keyguard-style UI",
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "build": "node scripts/build.ts",
    "build:chromium": "node scripts/build.ts --target=chromium",
    "build:firefox": "node scripts/build.ts --target=firefox",
    "watch": "node scripts/build.ts --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "e2e:helium": "KW_TARGET=chromium node --test --test-concurrency=1 tests/e2e/*.test.ts",
    "e2e:librewolf": "KW_TARGET=firefox node --test --test-concurrency=1 tests/e2e/*.test.ts",
    "perf": "node scripts/perf.ts",
    "dev-server": "sh scripts/dev-server.sh",
    "seed": "node scripts/seed.ts",
    "lint:firefox": "web-ext lint --source-dir dist/firefox",
    "sign:firefox": "web-ext sign --channel=unlisted --source-dir dist/firefox --artifacts-dir dist",
    "e2e": "npm run e2e:helium && npm run e2e:librewolf",
    "smoke": "node tests/e2e/smoke.ts"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "argon2id": "^1.0.1",
    "openpgp": "^6.3.2",
    "preact": "^11.0.1",
    "tldts": "^7.4.18"
  },
  "devDependencies": {
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@material-symbols/svg-400": "^0.48.0",
    "@material/material-color-utilities": "^0.4.0",
    "@types/chrome": "^0.3.5",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^21.0.1",
    "puppeteer-core": "^25.14.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0"
  }
}
